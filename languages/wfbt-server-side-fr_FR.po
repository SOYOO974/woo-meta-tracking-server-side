msgstr "Injecte fbevents.js et déclenche PageView, ViewContent, AddToCart (AJAX), InitiateCheckout et Purchase avec déduplication eventID."

#: includes/class-wfbt-admin-settings.php:243
msgid "2. GDPR Compliance & Concord Cookie Banner"
msgstr "2. Conformité RGPD & Bannière Concord"

#: includes/class-wfbt-admin-settings.php:246
msgid "Condition tracking on GDPR consent"
msgstr "Asservir le tracking au consentement RGPD"

#: includes/class-wfbt-admin-settings.php:250
msgid "Require marketing consent from Concord Cookie Banner"
msgstr "Conditionner le tracking au consentement marketing de Concord Cookie Banner"

#: includes/class-wfbt-admin-settings.php:252
msgid "Prevents Browser Pixel execution and blocks or anonymizes CAPI requests if consent is not granted."
msgstr "Empêche l'exécution du Pixel et bloque ou anonymise les requêtes CAPI si le consentement n'est pas accordé."

#: includes/class-wfbt-admin-settings.php:256
msgid "Concord cookie name or prefix"
msgstr "Nom ou préfixe du cookie Concord"

#: includes/class-wfbt-admin-settings.php:259
msgid "Cookie name or prefix used by your cookie banner (default: concord)."
msgstr "Préfixe ou nom de cookie utilisé par votre bannière (valeur par défaut : concord)."

#: includes/class-wfbt-admin-settings.php:263
msgid "CAPI action when consent is refused"
msgstr "Action CAPI en cas de refus du consentement"

#: includes/class-wfbt-admin-settings.php:283
msgid "3. Triggering & Order Statuses (Action Scheduler)"
msgstr "3. Déclenchement & Statuts de Commande (Action Scheduler)"

#: includes/class-wfbt-admin-settings.php:286
msgid "CAPI trigger order statuses"
msgstr "Statuts déclencheurs CAPI"

#: includes/class-wfbt-admin-settings.php:302
msgid "Order statuses that trigger the asynchronous Purchase event to Meta CAPI (defaults: Processing and Completed)."
msgstr "Statuts de commande qui déclenchent l'envoi asynchrone du Purchase vers Meta CAPI (par défaut : En cours et Terminé)."

#: includes/class-wfbt-admin-settings.php:306
msgid "Email Alerts on Failure"
msgstr "Alertes e-mail en cas d'erreur"

#: includes/class-wfbt-admin-settings.php:310
msgid "Send an email if a CAPI request fails."
msgstr "Envoyer un e-mail si une requête CAPI échoue."

#: includes/class-wfbt-admin-settings.php:315
msgid "Alert Email Address"
msgstr "Adresse e-mail d'alerte"

#: includes/class-wfbt-admin-settings.php:322
