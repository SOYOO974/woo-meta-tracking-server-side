#: includes/class-wfbt-admin-settings.php:184
msgid "1. Meta API & Pixel Settings"
msgstr "1. Paramètres Meta API & Pixel"

#: includes/class-wfbt-admin-settings.php:187
msgid "Meta Pixel ID"
msgstr "ID du Pixel Meta"

#: includes/class-wfbt-admin-settings.php:190
msgid "Your Meta Pixel ID (found in Meta Events Manager)."
msgstr "Votre identifiant de Pixel Meta (accessible dans le Gestionnaire d'événements Meta)."

#: includes/class-wfbt-admin-settings.php:194
msgid "Conversions API Access Token"
msgstr "Jeton d'accès Conversions API"

#: includes/class-wfbt-admin-settings.php:197
msgid "System User access token generated from Meta Events Manager > Settings > Conversions API."
msgstr "Jeton d'accès système généré depuis Meta Events Manager > Paramètres > API Conversions."

#: includes/class-wfbt-admin-settings.php:201
msgid "Test Event Code (Optional)"
msgstr "Code d'événement de test (Optionnel)"

#: includes/class-wfbt-admin-settings.php:204
msgid "Enter this code to see your events in real-time in Meta Events Manager \"Test events\" tab."
msgstr "Renseignez ce code pour visualiser vos événements en temps réel dans l'onglet « Tester les événements » de Meta."

#: includes/class-wfbt-admin-settings.php:208
msgid "Enable Browser Pixel"
msgstr "Activer le Pixel Navigateur"

#: includes/class-wfbt-admin-settings.php:212
msgid "Enable client-side tracking (fbq)"
msgstr "Activer le tracking côté client (fbq)"

#: includes/class-wfbt-admin-settings.php:214
msgid "Injects fbevents.js and fires PageView, ViewContent, AddToCart (AJAX), InitiateCheckout, and Purchase with eventID deduplication."
msgstr "Injecte fbevents.js et déclenche PageView, ViewContent, AddToCart (AJAX), InitiateCheckout et Purchase avec déduplication eventID."

#: includes/class-wfbt-admin-settings.php:221
msgid "2. GDPR Compliance & Concord Cookie Banner"
msgstr "2. Conformité RGPD & Bannière Concord"

#: includes/class-wfbt-admin-settings.php:224
msgid "Condition tracking on GDPR consent"
msgstr "Asservir le tracking au consentement RGPD"

#: includes/class-wfbt-admin-settings.php:228
msgid "Require marketing consent from Concord Cookie Banner"
msgstr "Conditionner le tracking au consentement marketing de Concord Cookie Banner"

#: includes/class-wfbt-admin-settings.php:230
msgid "Prevents Browser Pixel execution and blocks or anonymizes CAPI requests if consent is not granted."
msgstr "Empêche l'exécution du Pixel et bloque ou anonymise les requêtes CAPI si le consentement n'est pas accordé."

#: includes/class-wfbt-admin-settings.php:234
msgid "Concord cookie name or prefix"
msgstr "Nom ou préfixe du cookie Concord"

#: includes/class-wfbt-admin-settings.php:237
msgid "Cookie name or prefix used by your cookie banner (default: concord)."
msgstr "Préfixe ou nom de cookie utilisé par votre bannière (valeur par défaut : concord)."

#: includes/class-wfbt-admin-settings.php:241
msgid "CAPI action when consent is refused"
msgstr "Action CAPI en cas de refus du consentement"

#: includes/class-wfbt-admin-settings.php:261
msgid "3. Triggering & Order Statuses (Action Scheduler)"
msgstr "3. Déclenchement & Statuts de Commande (Action Scheduler)"

#: includes/class-wfbt-admin-settings.php:264
msgid "CAPI trigger order statuses"
msgstr "Statuts déclencheurs CAPI"

#: includes/class-wfbt-admin-settings.php:280
msgid "Order statuses that trigger the asynchronous Purchase event to Meta CAPI (defaults: Processing and Completed)."
msgstr "Statuts de commande qui déclenchent l'envoi asynchrone du Purchase vers Meta CAPI (par défaut : En cours et Terminé)."

#: includes/class-wfbt-admin-settings.php:284
msgid "Email Alerts on Failure"
msgstr "Alertes e-mail en cas d'erreur"

#: includes/class-wfbt-admin-settings.php:288
msgid "Send an email if a CAPI request fails."
msgstr "Envoyer un e-mail si une requête CAPI échoue."

#: includes/class-wfbt-admin-settings.php:293
msgid "Alert Email Address"
msgstr "Adresse e-mail d'alerte"

#: includes/class-wfbt-admin-settings.php:300
msgid "Save Changes"
msgstr "Enregistrer les modifications"

#: includes/class-wfbt-admin-settings.php:311
msgid "Meta CAPI Connection Test (v21.0)"
msgstr "Test de Connexion Meta CAPI (v21.0)"

#: includes/class-wfbt-admin-settings.php:312
msgid "Sends an immediate dummy Purchase test event to Meta Graph API using your configured Test Event Code."
msgstr "Envoie immédiatement un événement Purchase de test fictif vers Meta Graph API avec votre Test Event Code configuré."

#: includes/class-wfbt-admin-settings.php:317
msgid "Last 20 WooCommerce Orders (CAPI & Cookies Audit)"
msgstr "20 Dernières Commandes WooCommerce (Audit CAPI & Cookies)"

#: includes/class-wfbt-admin-settings.php:319
msgid "Native HPOS inspection of advertising identifiers (_fbp, _fbc), Concord consent state, and CAPI transmission status."
msgstr "Contrôle HPOS natif des identifiants publicitaires (_fbp, _fbc), du statut de consentement Concord et de l'état de transmission CAPI."

